# Every setting Hearth's server reads. All are optional; the default is shown.
# They are read from the environment: this file is a list, not something the server loads.
# On Linux the installer (deploy/linux/install.sh) writes the ones you give it into the
# service file, and keeps them when you run it again.

# Where it listens. This machine only by default; 0.0.0.0 lets every device on your home network
# open the sign-in page. Reach it from your phone through Tailscale rather than the internet.
# DC_HOST=127.0.0.1
# DC_PORT=7400                       # the web app and its API

# Where it keeps things.
# DC_DATA_DIR=./data                 # database, setup code, and local state
# DC_KEY_DIR=<DC_DATA_DIR>           # encryption keys; best in a separate folder, so a copy of the data folder alone cannot open the vault
# DC_BACKUP_DIR=<DC_DATA_DIR>/backups  # daily encrypted backups and the readable memory export
# DC_BACKUP_COPY_DIR=                # a second copy of each backup, on another drive or a synced folder (off when empty)
# DC_BACKUP_KEEP=14                  # how many daily backups to keep
# DC_OFFSITE_NAME=                   # name of another machine that fetches encrypted backup copies (turns that on)
# DC_SERVICE_BACKUP_DIR=             # where config files are backed up before an approved edit (the folder above DC_BACKUP_DIR when that is set, else <DC_DATA_DIR>/service-backups)
# DC_HOST_DOCS=                      # your own notes on how this machine is set up, read before changes (a "docs" folder beside the service backups, when there is one)
# DC_HOMELAB_ROOTS=                  # folders containers may be given without asking you each time, comma separated (e.g. /srv/docker,/mnt/media)
# DC_COMPOSE_ROOT=                   # where new Compose projects go, one folder each (found from your existing projects when empty)
# DC_ELEVATION=                      # 1 when the elevated executor is set up (install-elevation.sh sets it, with its socket and key)

# Your systems.
# DC_CADDYFILE=                      # your Caddyfile, for web addresses like radarr.example.com (found in a running Caddy container when empty)
# DC_VOICE_HOST=                     # machine running Whisper (port 10300) and Piper (port 10200); Settings can change it
# DC_CLAUDE_PATH=claude              # the Claude Code program the AI administrator runs

# More than one installation on one machine (installer only; docs/MULTIPLE_INSTALLS.md).
# DC_SERVICE_NAME=dragon-control     # the systemd service's name; found from the folder when left out
# DC_SERVICE_USER=<you>              # the account the service runs as (a dedicated one for a trial)
# DC_AUTOSTART=yes                   # "no" keeps it off at boot; start and stop it by hand
# DC_MEMORY_MAX=                     # a hard memory limit, like 1G (off when empty; "none" removes it)
# DC_MEMORY_HIGH=                    # slow it down above this, like 768M
# DC_CPU_QUOTA=                      # a processor limit, like 100% (one core)
# DC_RESTART_LIMIT=                  # stop restarting after N failed starts in S seconds, like 5/600 (off: restarts forever)

# Behaviour.
# DC_DEMO=on                         # "off" hides sample data and the demo scenarios
# DC_MONITOR=on                      # "off" stops scheduled health checks (checks you start still run)
# DC_BACKUPS=on                      # "off" stops the daily backup
# DC_WEB_DIR=apps/web/dist           # the built web app the server shows

# Development only.
# DC_WEB_PORT=7401                   # the hot-reloading web app (pnpm dev)

# Tests and safe previews only. Never set these on a real installation.
# DC_FAKE_DISCOVERY=1                # scan a made-up homelab instead of this machine
# DC_FAKE_AGENT=1                    # a scripted stand-in for Claude Code
# DC_FAKE_APPS=1                     # stand-in apps
# DC_FAKE_VOICE=1                    # stand-in speech services

# The Claude Code companion plugin (integrations/claude-code), not the server.
# DC_COMPANION_HOME=~/.dragon-control  # where the companion keeps its settings
# DC_COMPANION_TIMEOUT_MS=6000         # how long it waits for Hearth
